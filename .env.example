# Copy to .env.local. Never commit real keys.

# Resend API key (resend.com → API Keys). Without it the enquiry form shows its error state.
RESEND_API_KEY=

# Optional. Sender address; defaults to Resend's test sender (onboarding@resend.dev),
# which only delivers to the Resend account owner's address until a domain is verified.
RESEND_FROM=

# Optional. Recipient; defaults to the school email in src/lib/content/navigation.ts.
ENQUIRY_TO=
